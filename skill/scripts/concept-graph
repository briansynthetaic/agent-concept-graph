#!/bin/bash
# Run the CLI from the installed skill, or build it in a fresh checkout.
set -euo pipefail

# Follow symlinks, so this works when the skill is linked into ~/.claude/skills.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SKILL_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
BIN="$SKILL_DIR/bin/concept-graph"

if [ ! -x "$BIN" ]; then
  BUILD="$SKILL_DIR/../scripts/build.sh"
  if [ -x "$BUILD" ]; then
    echo "concept-graph: building the CLI (first run only)…" >&2
    "$BUILD" --if-missing >&2
  else
    echo "error: the concept-graph CLI has not been built: $BIN is missing." >&2
    echo "Run 'make' in the concept-graph source checkout, then copy or link its skill/ directory here." >&2
    exit 1
  fi
fi

exec "$BIN" "$@"
